# attendance-service — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/attendance-service.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=3008
LOG_LEVEL=info

DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=attendance-service

# Customer access tokens: ES256, checked against auth-service's public keys at
# AUTH_SERVICE_URL/.well-known/jwks.json (or AUTH_JWKS_URL). No shared secret.
AUTH_SERVICE_URL=http://auth-service:4000
# AUTH_JWKS_URL=
# Company and branch come from the token. Old app builds still send the branch
# they show; while this is true, another branch is accepted after auth-service
# confirms the user may use it (cached ACCESS_CACHE_TTL_MS). Set false once the
# apps call /auth/api/switch-context.
AUTH_ALLOW_REQUESTED_BRANCH=true
ACCESS_CACHE_TTL_MS=60000
# Refuse tokens of sessions revoked in the last 15 minutes (needs auth-service's Redis).
AUTH_CHECK_REVOKED_SESSIONS=false
PAYROLL_SERVICE_URL=http://payroll-service:4004
# Employees (records, documents, faces) are employee-service's; this service reads the branch roster from it.
EMPLOYEE_SERVICE_URL=http://employee-service:4002

# Service-to-service tokens (scripts/gen-secrets.sh writes them; openssl rand -hex 32).
# This service's own token, sent as X-Internal-Token on its /internal calls to auth-service,
# payroll-service and employee-service (they hold it as INTERNAL_TOKEN_ATTENDANCE):
INTERNAL_TOKEN=
# Redis of auth-service's revoked-session deny-list (AUTH_CHECK_REVOKED_SESSIONS=true).
# REDIS_URL=redis://localhost:6380
# DEV ONLY: true = JWT access/refresh tokens are NOT checked; callers send X-User-Id / X-Zodu-Id / X-Branch-Id. Never in production.
# AUTH_DISABLED=false

