# file-service — copy to .env (local: .env.local with NODE_ENV=local). Never commit real values.
PORT=4007

# Own database (create it once: CREATE DATABASE file_service;)
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=file_service

# Same value as auth-service's APP_SECRET (verifies the users' access tokens)
APP_SECRET=

# MinIO — a dedicated user whose policy allows only this bucket (docs/file-service/minio-setup.md)
MINIO_INTERNAL_URL=http://minio:9000
MINIO_PUBLIC_URL=https://files.myzodu.com
MINIO_REGION=us-east-1
MINIO_ACCESSKEY=
MINIO_SECRETKEY=
MINIO_BUCKET_NAME=zodu-files
PRESIGNED_URL_TTL=900
# Old shared bucket: read-only, serves the /{service}/file/* URLs stored before file-service. Empty disables.
LEGACY_BUCKET_NAME=zodu

# Gateway origin used for the stable /files/v/:fileId links (UAT api.myzodu.com, prod api.zodu.in)
PUBLIC_FILE_BASE_URL=https://api.myzodu.com

# auth-service access checks
AUTH_SERVICE_URL=http://auth-service:4000
ACCESS_CACHE_TTL_MS=60000

# Service-to-service tokens (scripts/gen-secrets.sh writes them).
# This service's own token, sent as X-Internal-Token (auth-service has it as INTERNAL_TOKEN_FILE):
INTERNAL_TOKEN=
# The services allowed to call /internal/* here, each with its own token:
INTERNAL_TOKEN_AUTH=
INTERNAL_TOKEN_EMPLOYEE=
INTERNAL_TOKEN_CHECKLIST=
INTERNAL_TOKEN_RETAIL=
INTERNAL_TOKEN_RESTAURANT=

# Shared rate-limit store (required when NODE_ENV=production)
REDIS_URL=redis://redis:6379

MAX_CONCURRENT_UPLOADS=4
UPLOAD_QUEUE_TIMEOUT_MS=15000
PURGE_AFTER_DAYS=30
PURGE_JOB_ENABLED=true
# Hours before unclaimed /upload files are removed. 0 = keep (until Phase 3 claims the remaining fields).
STAGING_TTL_HOURS=0
# Proxies whose X-Forwarded-For is trusted (the gateway is on the docker network)
TRUST_PROXY=loopback, linklocal, uniquelocal
LOG_LEVEL=info
