{
  "name": "file-service",
  "version": "1.0.0",
  "description": "Central file storage for Zodu: tenant/branch/module layout on MinIO, content inspection, presigned downloads",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "set NODE_ENV=local&& node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:services": "node --test test/services/*.test.js"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4"
  }
}
