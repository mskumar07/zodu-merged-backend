{
  "name": "checklist-v2-service",
  "version": "1.0.0",
  "description": "Checklist v2: definitions, recurring runs, rules and notifications (docs/checklist-v2/ARCHITECTURE.md)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/server.js --worker",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/server.js --worker",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@zodu/security": "file:../packages/zodu-security",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "ioredis": "^5.11.1",
    "joi": "^18.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.11.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "globalSetup": "./test/global-setup.js",
    "globalTeardown": "./test/global-teardown.js",
    "setupFiles": [
      "./test/env.js"
    ],
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
