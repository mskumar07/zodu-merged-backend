# auth-service — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/auth-service.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=4000
LOG_LEVEL=info

DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=retail_auth_service

# ── Access tokens: ES256, 15 minutes ─────────────────────────────────────────
# P-256 private key, PKCS#8 PEM or the PEM base64 on one line (gen-secrets.sh
# writes it). Required in production; local/dev runs without one generate a
# temporary key (every restart then signs everyone out).
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl base64 -A
JWT_PRIVATE_KEY=
JWT_KID=
# During a key rotation only: the old public key (PEM / base64) and its kid,
# still published in the JWKS so tokens signed before the switch verify.
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KID=
# JWT_ISSUER=zodu-auth
# JWT_AUDIENCE=zodu-api
ACCESS_TOKEN_TTL_SECONDS=900

# ── Refresh tokens / sessions (Redis) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REFRESH_IDLE_DAYS=30
SESSION_MAX_DAYS=90
REFRESH_REUSE_GRACE_SECONDS=30
# true: refuse requests without X-Client-Platform (web | desktop | mobile).
AUTH_REQUIRE_PLATFORM_HEADER=false
# Old HS256 refresh tokens (before this release) are exchanged once for a new
# session until this date (ISO 8601). Empty: still accepted. Needs APP_SECRET.
LEGACY_REFRESH_CUTOFF=
# Only to verify those old refresh tokens. Nothing is signed with it any more;
# remove it after LEGACY_REFRESH_CUTOFF.
APP_SECRET=

# ── Login hardening ──────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_MIN=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
SIGNUP_RATE_LIMIT_PER_MIN=5
# Hops whose X-Forwarded-For is trusted (default: loopback and private networks).
# TRUST_PROXY=

RETAIL_SERVICE_URL=http://retail-service:4001
RESTAURANT_SERVICE_URL=http://restaurant-service:4003
EMPLOYEE_SERVICE_URL=http://employee-service:4002
PAYROLL_SERVICE_URL=http://payroll-service:4004
CHECKLIST_SERVICE_URL=http://checklist-service:4005
FILE_SERVICE_URL=http://file-service:4007

# Service-to-service tokens (scripts/gen-secrets.sh writes them; openssl rand -hex 32).
# This service's own token, sent as X-Internal-Token on its /internal calls:
INTERNAL_TOKEN=
# Services allowed to call this service's /internal routes, one token each:
INTERNAL_TOKEN_RESTAURANT=
INTERNAL_TOKEN_RETAIL=
INTERNAL_TOKEN_ADMIN=
INTERNAL_TOKEN_EMPLOYEE=
INTERNAL_TOKEN_FILE=
