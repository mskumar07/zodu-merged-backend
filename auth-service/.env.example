# auth-service — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/auth-service.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=4000
LOG_LEVEL=info

DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=retail_auth_service

# Signs / verifies the customer access tokens (same value in every service that
# verifies them). Rotated with the auth phase; never admin-service's secret.
APP_SECRET=

RETAIL_SERVICE_URL=http://retail-service:4001
RESTAURANT_SERVICE_URL=http://restaurant-service:4003
EMPLOYEE_SERVICE_URL=http://employee-service:4002
PAYROLL_SERVICE_URL=http://payroll-service:4004
CHECKLIST_SERVICE_URL=http://checklist-service:4005
FILE_SERVICE_URL=http://file-service:4007

# Service-to-service tokens (scripts/gen-secrets.sh writes them; openssl rand -hex 32).
# This service's own token, sent as X-Internal-Token on its /internal calls:
INTERNAL_TOKEN=
# Services allowed to call this service's /internal routes, one token each:
INTERNAL_TOKEN_RESTAURANT=
INTERNAL_TOKEN_RETAIL=
INTERNAL_TOKEN_ADMIN=
INTERNAL_TOKEN_EMPLOYEE=
INTERNAL_TOKEN_FILE=
