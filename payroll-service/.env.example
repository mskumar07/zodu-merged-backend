# payroll-service — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/payroll-service.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=4004
LOG_LEVEL=info

DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=payroll-service

# Service-to-service tokens (scripts/gen-secrets.sh writes them; openssl rand -hex 32).
# Services allowed to call this service's /internal routes, one token each:
INTERNAL_TOKEN_EMPLOYEE=
INTERNAL_TOKEN_AUTH=
