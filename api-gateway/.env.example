# api-gateway — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/api-gateway.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=5001

# Web app origins allowed by CORS, comma-separated, exact (scheme + host [+ port]).
# Required in production. Never "*". Requests without an Origin (mobile, desktop
# main process) are not affected. An Electron renderer loaded from file:// sends
# "Origin: null"; don't list "null" (sandboxed pages send it too): serve the
# renderer from a custom scheme (app://zodu) and list that instead.
CORS_ORIGINS=

# Shared rate-limit counters (password from env/redis.<env>.env)
REDIS_URL=redis://:password@redis:6379

# Number of proxies in front of the gateway (the HTTPS reverse proxy = 1)
TRUST_PROXY=1
RATE_LIMIT_IP_PER_MIN=600
# /auth/api/login, /create-account, /refresh-token, per IP
AUTH_RATE_LIMIT_PER_MIN=30
# Largest request body (bytes); services enforce their own, tighter limits
MAX_BODY_BYTES=27262976
PROXY_TIMEOUT_MS=120000

AUTH_SERVICE_URL=http://auth-service:4000
RETAIL_SERVICE_URL=http://retail-service:4001
EMPLOYEE_SERVICE_URL=http://employee-service:4002
RESTAURANT_SERVICE_URL=http://restaurant-service:4003
CHECKLIST_SERVICE_URL=http://checklist-service:4005
ADMIN_SERVICE_URL=http://admin-service:4006
FILE_SERVICE_URL=http://file-service:4007
