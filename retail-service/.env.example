# retail-service — copy to .env for local runs (NODE_ENV=local reads .env.local).
# On UAT / prod these values come from env/retail-service.<env>.env (docker compose
# env_file); non-secret settings are in the compose file. Never commit real values.
PORT=4001
LOG_LEVEL=info

DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=retail_restaurant_service

FILE_SERVICE_URL=http://file-service:4007

# Service-to-service tokens (scripts/gen-secrets.sh writes them; openssl rand -hex 32).
# This service's own token, sent as X-Internal-Token on its /internal calls:
INTERNAL_TOKEN=
# Services allowed to call this service's /internal routes, one token each:
INTERNAL_TOKEN_AUTH=
INTERNAL_TOKEN_ADMIN=

# Customer access tokens: ES256, checked against auth-service's public keys at
# AUTH_SERVICE_URL/.well-known/jwks.json (or AUTH_JWKS_URL). No shared secret.
AUTH_SERVICE_URL=http://auth-service:4000
# AUTH_JWKS_URL=
# Company and branch come from the token. Old app builds still send the branch
# they show; while this is true, another branch is accepted after auth-service
# confirms the user may use it (cached ACCESS_CACHE_TTL_MS). Set false once the
# apps call /auth/api/switch-context.
AUTH_ALLOW_REQUESTED_BRANCH=true
ACCESS_CACHE_TTL_MS=60000
# Refuse tokens of sessions revoked in the last 15 minutes (needs auth-service's Redis).
AUTH_CHECK_REVOKED_SESSIONS=false
